# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Used only by the helper scripts in scripts/ for development and diagnosis.
# The plugin itself never reads this file — when Stash runs a plugin it passes a
# session cookie in server_connection, so the runtime needs no credentials of its own.

# Base URL of the Stash instance, no trailing slash.
STASH_URL=http://stash.example.lan:9999

# Settings -> Security -> Authentication -> API Key
STASH_API_KEY=

# Optional: where the plugin is deployed, for the sync helper.
STASH_SSH_HOST=root@stash.example.lan
STASH_PLUGIN_DIR=/path/to/stash/plugins/CustomizableDuplicateRemover
